[TEMPLATE]
# ── Spark Dating App — Environment Variables ──────────────────────
# Copy this file to .env and fill in the values.

# ── API Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001

# JWT secret (REQUIRED in production — app crashes without it)
JWT_SECRET=your-secret-key-here

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Upload directory (Railway: /data/uploads for persistent volume)
UPLOAD_DIR=./uploads

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spark

# ── Redis (optional — falls back to in-memory rate limiting) ─────
REDIS_URL=redis://localhost:6379

# ── SMTP Email (optional — falls back to console logging) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Spark <noreply@spark.dating>

# ── Password Reset ────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Stripe Payments (optional — enables web-based checkout) ──────
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe Dashboard > Products
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_YEARLY=

# ── Apple App Store ───────────────────────────────────────────────
# Shared secret for App Store Server Notifications V2
# Get it from: App Store Connect > Apps > Your App > App Information > App Store Server API
APPLE_SHARED_SECRET=

# ── Google Play Store ─────────────────────────────────────────────
# Service account JSON key for Android Publisher API
# Get it from: Google Cloud Console > IAM > Service Accounts > Keys
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_PLAY_PACKAGE=com.spark.dating

# ── AI Service ────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── OpenAI (optional — AI service works without it using fallbacks) ──
OPENAI_API_KEY=

# ── Mobile App (Expo) ────────────────────────────────────────────
# Set these in apps/mobile/.env
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_EAS_PROJECT_ID=your-project-id

# ── Web Admin ─────────────────────────────────────────────────────
# Set this in apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:3001
