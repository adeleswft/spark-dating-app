{
  "expo": {
    "name": "Spark",
    "slug": "spark-dating",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spark",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF4458"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spark.dating",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF4458"
      },
      "package": "com.spark.dating",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-auth-session",
      "expo-web-browser",      "expo-screen-capture",
      ["expo-camera",
        {
          "cameraPermission": "Spark needs camera access for photo verification and profile photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spark needs access to your photos for profile pictures."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Spark uses your location to show you people nearby."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00E676"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
