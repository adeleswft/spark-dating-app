{
  "name": "@spark/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug --cleanup",
    "e2e:test:android": "detox test --configuration android.emu.debug --cleanup",
    "e2e:test:ios:ci": "detox test --configuration ios.sim.release --workers 1 --cleanup",
    "e2e:test:android:ci": "detox test --configuration android.emu.release --workers 1 --cleanup"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@react-navigation/native": "^7.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.60.0",
    "date-fns": "^4.4.0",
    "expo": "~52.0.0",
    "expo-auth-session": "~6.0.0",
    "expo-camera": "~16.0.0",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.0",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.0",
    "expo-image-manipulator": "~13.0.0",
    "expo-image-picker": "~16.0.0",
    "expo-linking": "~7.0.0",
    "expo-notifications": "^0.29.14",
    "expo-router": "~4.0.0",
    "expo-screen-capture": "~7.0.1",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.0",
    "puppeteer": "^25.9.0",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-mmkv": "^2.12.0",
    "react-native-paper": "^5.12.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-vector-icons": "^10.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@spark/shared": "*",
    "@types/jest": "^29.5.0",
    "@types/react": "~18.3.0",
    "detox": "^20.33.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "typescript": "~5.3.0"
  }
}
