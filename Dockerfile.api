# ── Build stage ──────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./
COPY packages/api/package.json packages/api/
COPY packages/shared/package.json packages/shared/

# Install all dependencies (including dev for build)
RUN npm ci --ignore-scripts

# Copy source
COPY packages/api/ packages/api/
COPY packages/shared/ packages/shared/

# Build shared package
RUN cd packages/shared && npx tsc

# ── Production stage ────────────────────────────────────────────
FROM node:20-alpine AS production

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup -g 1001 -S spark && \
    adduser -S spark -u 1001

# Copy package files
COPY package.json package-lock.json ./
COPY packages/api/package.json packages/api/
COPY packages/shared/package.json packages/shared/

# Install production dependencies only
RUN npm ci --ignore-scripts --omit=dev

# Install tsx and drizzle-kit globally (needed for schema push + seed at startup)
RUN npm install -g tsx drizzle-kit

# Copy built shared package
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist

# Copy API source and config
COPY packages/api/src ./packages/api/src
COPY packages/api/drizzle.config.ts ./packages/api/drizzle.config.ts

# Create uploads directory (persistent volume mount point)
RUN mkdir -p /data/uploads && chown spark:spark /data/uploads

# Switch to non-root user
USER spark

# Make globally installed packages (tsx, drizzle-kit) discoverable
ENV NODE_PATH=/usr/local/lib/node_modules

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

# Start API
ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "-c", "cd packages/api && npx drizzle-kit push --force 2>&1 && npx tsx packages/api/src/seed.ts 2>&1; cd /app && exec node --import tsx packages/api/src/index.ts"]
# Cache bust: fix tsx/drizzle-kit install + schema push + seed + healthcheck 2026-08-27
