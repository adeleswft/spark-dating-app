{
  "name": "spark-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "dependencies": {
    "tsx": "^4.23.12",
    "drizzle-kit": "^0.28.1"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.11",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/shared",
    "packages/api",
    "packages/eslint-config",
    "packages/typescript-config",
    "packages/ui"
  ]
}
