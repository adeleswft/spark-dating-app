# ── Spark Dating App — Production Environment ────────────────────
# Copy this to your deployment platform and fill in the values.

# ── API Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
API_URL=https://your-api-domain.com

# JWT secret (GENERATE A STRONG ONE: openssl rand -hex 32)
JWT_SECRET=

# CORS origins (your web admin domain + mobile app)
CORS_ORIGINS=https://your-admin-domain.vercel.app,http://localhost:8081

# ── Database ──────────────────────────────────────────────────────
# Use your Railway/Neon/Supabase connection string
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────
# Use your Upstash/Redis Cloud URL (optional but recommended)
REDIS_URL=

# ── SMTP Email ────────────────────────────────────────────────────
# Gmail: use App Password (not your real password)
# SendGrid: use API key as password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Spark <noreply@yourdomain.com>

# ── Password Reset ────────────────────────────────────────────────
APP_URL=https://your-admin-domain.vercel.app

# ── Apple App Store ───────────────────────────────────────────────
APPLE_SHARED_SECRET=

# ── Google Play Store ─────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_PLAY_PACKAGE=com.spark.dating

# ── AI Service ────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── OpenAI (optional) ─────────────────────────────────────────────
OPENAI_API_KEY=
